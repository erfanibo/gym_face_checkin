# کپی کنید به .env و مقادیر واقعی رو جایگزین کنید. .env هرگز commit نمی‌شود.

# --- لاگین (الزامی) ---------------------------------------------------------
# کلید امضای کوکی سشن. اگر ست نشود، docker compose بالا نمی‌آید (عمداً، تا
# لاگین‌ها با هر ری‌استارت/rebuild از بین نروند). یک‌بار بسازید و همیشه همین
# مقدار را نگه دارید:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# فقط اولین باری که سیستم اجرا می‌شود استفاده می‌شود (وقتی هنوز هیچ رمزی در
# دیتابیس ثبت نشده). بلافاصله بعد از اولین ورود، از تب «تنظیمات» عوضش کنید —
# بعد از آن این مقدار دیگر هیچ اثری ندارد.
MANAGER_INITIAL_PASSWORD=changeme

# --- Webhook (اختیاری) ------------------------------------------------------
# آدرس سروری که باید هر رویداد ورود/خروج فوری بهش POST بشه. اگر خالی باشد،
# webhook کلاً غیرفعال است (فقط از polling روی /api/attendance استفاده کنید).
WEBHOOK_URL=http://192.168.1.20:9000/gym-events

# رشتهٔ راز مشترک برای امضای HMAC-SHA256 هر درخواست (هدر X-Webhook-Signature).
# سرور گیرنده باید همین مقدار رو برای تأیید امضا داشته باشد. خالی = بدون امضا.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- بررسی به‌روزرسانی (اختیاری) --------------------------------------------
# ریپوی GitHub که «تنظیمات > به‌روزرسانی سیستم» آخرین Release آن را می‌پرسد (فقط وقتی
# مدیر دکمه را بزند؛ هیچ درخواست پس‌زمینه‌ای نیست). اگر پروژه را فورک کرده‌اید
# «owner/repo» خودتان را بگذارید. خط را کاملاً پاک کنید = پیش‌فرض پروژه؛
# مقدار خالی (UPDATE_CHECK_REPO=) = بررسی غیرفعال.
# UPDATE_CHECK_REPO=erfanibo/gym_face_checkin

# --- موتور تشخیص چهره (اختیاری) ---------------------------------------------
# پیش‌فرض: DeepFace با مدل SFace و آشکارساز YuNet (سبک، مناسب CPU بدون GPU).
# فقط بعد از اجرای scripts/benchmark_deepface.py روی همین PC عوضشان کنید.
# RECOGNIZER_BACKEND=deepface        # یا dlib (موتور قبلی؛ نیاز به requirements-dlib.txt)
# DEEPFACE_MODEL=SFace               # SFace | Facenet512 | ArcFace | Buffalo_L | ...
# DEEPFACE_DETECTOR=yunet            # yunet | opencv | retinaface (کند) | ...
# آستانه‌ی تشخیص: خالی = پیش‌فرض خودِ مدل. عدد را فقط بعد از تست با افراد واقعی بدهید و یادتان باشد
# عددی که برای یک مدل تنظیم شده برای مدل دیگر بی‌معنی است (فاصله‌ی cosine؛ کمتر = شبیه‌تر).
# KNOWN_USER_TOLERANCE=
# PENDING_DEDUP_TOLERANCE=
# REGISTRATION_DUPLICATE_FACE_TOLERANCE=
