# کپی کنید به .env و مقادیر واقعی رو جایگزین کنید. .env هرگز commit نمی‌شود.

# --- لاگین (الزامی) ---------------------------------------------------------
# کلید امضای کوکی سشن. اگر ست نشود، docker compose بالا نمی‌آید (عمداً، تا
# لاگین‌ها با هر ری‌استارت/rebuild از بین نروند). یک‌بار بسازید و همیشه همین
# مقدار را نگه دارید:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# فقط اولین باری که سیستم اجرا می‌شود استفاده می‌شود (وقتی هنوز هیچ رمزی در
# دیتابیس ثبت نشده). بلافاصله بعد از اولین ورود، از تب «تنظیمات» عوضش کنید —
# بعد از آن این مقدار دیگر هیچ اثری ندارد.
MANAGER_INITIAL_PASSWORD=changeme

# --- Webhook (اختیاری) ------------------------------------------------------
# آدرس سروری که باید هر رویداد ورود/خروج فوری بهش POST بشه. اگر خالی باشد،
# webhook کلاً غیرفعال است (فقط از polling روی /api/attendance استفاده کنید).
WEBHOOK_URL=http://192.168.1.20:9000/gym-events

# رشتهٔ راز مشترک برای امضای HMAC-SHA256 هر درخواست (هدر X-Webhook-Signature).
# سرور گیرنده باید همین مقدار رو برای تأیید امضا داشته باشد. خالی = بدون امضا.
WEBHOOK_SECRET=change-me-to-a-long-random-string
