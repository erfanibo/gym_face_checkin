# کپی کنید به .env و مقادیر واقعی رو جایگزین کنید. .env هرگز commit نمی‌شود.

# آدرس سروری که باید هر رویداد ورود/خروج فوری بهش POST بشه. اگر خالی باشد،
# webhook کلاً غیرفعال است (فقط از polling روی /api/attendance استفاده کنید).
WEBHOOK_URL=http://192.168.1.20:9000/gym-events

# رشتهٔ راز مشترک برای امضای HMAC-SHA256 هر درخواست (هدر X-Webhook-Signature).
# سرور گیرنده باید همین مقدار رو برای تأیید امضا داشته باشد. خالی = بدون امضا.
WEBHOOK_SECRET=change-me-to-a-long-random-string
